# Copy this file to .env and fill in your real key.
# Expo automatically exposes vars prefixed EXPO_PUBLIC_ to the JS bundle.
# Get your free Gemini API key from https://aistudio.google.com/apikey
EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

# TinyFish (live web agent) — create a key at https://agent.tinyfish.ai/api-keys
EXPO_PUBLIC_TINYFISH_API_KEY=your_tinyfish_api_key_here
