{
  "expo": {
    "name": "Nyaya Setu",
    "slug": "nyaya-setu",
    "owner": "hackpeeps",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.hackpeeps.nyayasetu",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#241528"
      },
      "permissions": [
        "RECORD_AUDIO",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Nyaya Setu to use your location to find nearby help centres."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Nyaya Setu to use the microphone so you can speak your problem in your own language."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "backgroundColor": "#241528",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "99db725f-8987-4946-9d26-2fea618bbeb8"
      }
    }
  }
}
